local camera=workspace.CurrentCamera camera.CameraType=Enum.CameraType.Scriptable
local own=E.localPlayer.Character:FindFirstChildOfClass("Humanoid")camera.CameraSubject=own
T.selectGame()E.click(T.main,"  Spectate")
eq(SC.spectate.target,E.other,"Initial username selection")
