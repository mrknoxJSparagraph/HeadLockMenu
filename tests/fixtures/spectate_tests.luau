eq(overlay.Parent,T.gui,"Spectate controls belong to the screen")
eq(overlay.Position.Y.Scale,1)eq(overlay.Position.Y.Offset,-112,"Above the hotbar")
eq(overlay.Visible,false,"Hidden while OFF")
assert(not E.find(T.content,"◀","TextButton"),"No arrows inside the menu")
assert(E.find(overlay,E.other.Name,"TextLabel"))
T.setSelected(E.other)
E.click(T.content,"OFF")eq(SC.spectate.enabled,true)eq(SC.enabled,false,"Aimbot camera conflict stopped")
eq(overlay.Visible,true)
eq(camera.CameraSubject,E.other.Character:FindFirstChildOfClass("Humanoid"))
