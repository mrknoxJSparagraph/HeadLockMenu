right.Activated:Fire()eq(SC.spectate.target,E.owner,"Juggernaut and owner can be spectated")
eq(camera.CameraSubject,E.owner.Character:FindFirstChildOfClass("Humanoid"))
assert(E.find(overlay,E.owner.Name,"TextLabel"))
left.Activated:Fire()eq(SC.spectate.target,E.other)
E.click(T.content,"ON")eq(SC.spectate.enabled,false)eq(camera.CameraSubject,own)eq(camera.CameraType,Enum.CameraType.Scriptable)
eq(overlay.Visible,false)
right.Activated:Fire()eq(camera.CameraSubject,own,"Arrows do not move the camera while OFF")
E.click(T.content,"OFF")eq(SC.spectate.enabled,true)
T.main.Visible=false
right.Activated:Fire()
eq(overlay.Visible,true,"Controls remain visible with the menu hidden")
